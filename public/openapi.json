{
  "openapi": "3.0.3",
  "info": {
    "title": "TextDB EdgeOne API",
    "description": "基于 EdgeOne Pages + KV 的在线文本数据库。匿名写入/读取，无用户系统。支持密码保护、HTML/JS/Markdown 渲染、文件夹批量上传。\n\n## 认证\n\n部分操作（更新/删除已设置密码的 Key）需要通过 `X-Password` 请求头或 `password` 表单参数提供密码。读取操作始终不需要密码。\n\n## Key 规则\n\n- 仅支持字母、数字、下划线：`^[0-9a-zA-Z_]{1,512}$`\n- 单个 Value 最大 5 MiB\n- 每个 IP 每日写入/删除限 500 次",
    "version": "1.3.0",
    "contact": {
      "name": "TextDB EdgeOne",
      "url": "https://github.com/sixiang-world/textdb-edgeone"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "当前站点"
    }
  ],
  "tags": [
    {
      "name": "Write",
      "description": "写入、更新、删除数据"
    },
    {
      "name": "Read",
      "description": "读取数据（原始/渲染/文件）"
    },
    {
      "name": "Stats",
      "description": "统计信息"
    }
  ],
  "components": {
    "parameters": {
      "KeyPath": {
        "name": "key",
        "in": "path",
        "required": true,
        "description": "数据标识，仅支持字母、数字、下划线，最长 512 字符",
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z_]{1,512}$",
          "example": "mykey"
        }
      },
      "ExtPath": {
        "name": "ext",
        "in": "path",
        "required": true,
        "description": "文件扩展名（不含点），如 `js`、`css`、`json`、`txt`。`html` 和 `svg` 被拒绝，请使用 `/p/{key}` 渲染 HTML",
        "schema": {
          "type": "string",
          "example": "js"
        }
      },
      "XPassword": {
        "name": "X-Password",
        "in": "header",
        "required": false,
        "description": "Key 的密码（更新/删除已设置密码的 Key 时必填）",
        "schema": {
          "type": "string",
          "example": "mypassword"
        }
      }
    },
    "schemas": {
      "WriteRequest": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": {
            "type": "string",
            "description": "数据标识",
            "pattern": "^[0-9a-zA-Z_]{1,512}$",
            "example": "mykey"
          },
          "value": {
            "type": "string",
            "description": "文本数据，最大 5 MiB。留空（空字符串）则删除该 Key"
          },
          "password": {
            "type": "string",
            "description": "密码。首次写入时设置；后续更新/删除需传入验证。4-128 字符"
          },
          "new_password": {
            "type": "string",
            "description": "新密码。传入正确的 `password` 后可修改密码；传空字符串 `\"\"` 则移除密码保护"
          }
        }
      },
      "WriteResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "1 = 成功，0 = 失败",
            "enum": [0, 1]
          },
          "data": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "example": "mykey"
              },
              "url": {
                "type": "string",
                "description": "写入成功后返回的读取 URL（仅写入时）",
                "example": "https://example.com/mykey"
              },
              "action": {
                "type": "string",
                "description": "操作类型（仅删除时）",
                "enum": ["deleted"]
              }
            }
          },
          "error": {
            "type": "string",
            "description": "错误信息（仅失败时）"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [1]
          },
          "data": {
            "type": "object",
            "properties": {
              "totalKeys": {
                "type": "integer",
                "description": "总 Key 数量（最多扫描 5000 个）",
                "example": 128
              },
              "totalSize": {
                "type": "integer",
                "description": "总存储量（字节）",
                "example": 524288
              },
              "writesToday": {
                "type": "integer",
                "description": "今日写入次数",
                "example": 42
              },
              "scannedAll": {
                "type": "boolean",
                "description": "是否扫描完全部 Key（超过 5000 时为 false，totalKeys 为下限）"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "enum": [0]
          },
          "error": {
            "type": "string",
            "description": "错误信息"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误（Key 格式无效、密码错误、Value 过大等）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "invalidKey": {
                "summary": "无效 Key",
                "value": {
                  "status": 0,
                  "error": "Invalid Key"
                }
              },
              "passwordRequired": {
                "summary": "需要密码",
                "value": {
                  "status": 0,
                  "error": "Password required"
                }
              },
              "incorrectPassword": {
                "summary": "密码错误",
                "value": {
                  "status": 0,
                  "error": "Incorrect password"
                }
              },
              "valueTooLarge": {
                "summary": "Value 超过 5 MiB",
                "value": {
                  "status": 0,
                  "error": "Value too large (max 5 MiB)"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Key 不存在",
        "content": {
          "text/plain": {
            "example": "Not Found"
          }
        }
      }
    }
  },
  "paths": {
    "/update/": {
      "post": {
        "tags": ["Write"],
        "summary": "写入 / 更新 / 删除",
        "description": "通用写入接口。支持 JSON 和 `application/x-www-form-urlencoded` 两种格式。\n\n- `value` 非空 → 写入或更新 Key\n- `value` 为空字符串 → 删除 Key\n- 首次写入时传 `password` 可设置密码保护\n- 已设密码的 Key，更新/删除需传 `password` 验证；传 `new_password` 可改密，传空字符串可移除密码",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteRequest"
              },
              "examples": {
                "write": {
                  "summary": "写入数据",
                  "value": {
                    "key": "mykey",
                    "value": "hello world"
                  }
                },
                "writeWithPassword": {
                  "summary": "写入并设置密码",
                  "value": {
                    "key": "secretkey",
                    "value": "secret content",
                    "password": "mypassword"
                  }
                },
                "updateWithPassword": {
                  "summary": "更新已设密码的 Key",
                  "value": {
                    "key": "secretkey",
                    "value": "new content",
                    "password": "mypassword"
                  }
                },
                "changePassword": {
                  "summary": "修改密码",
                  "value": {
                    "key": "secretkey",
                    "value": "content unchanged",
                    "password": "oldpassword",
                    "new_password": "newpassword"
                  }
                },
                "removePassword": {
                  "summary": "移除密码保护",
                  "value": {
                    "key": "secretkey",
                    "value": "content unchanged",
                    "password": "mypassword",
                    "new_password": ""
                  }
                },
                "delete": {
                  "summary": "删除 Key（value 为空）",
                  "value": {
                    "key": "mykey",
                    "value": ""
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/WriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResponse"
                },
                "examples": {
                  "writeSuccess": {
                    "summary": "写入成功",
                    "value": {
                      "status": 1,
                      "data": {
                        "key": "mykey",
                        "url": "https://example.com/mykey"
                      }
                    }
                  },
                  "deleteSuccess": {
                    "summary": "删除成功",
                    "value": {
                      "status": 1,
                      "data": {
                        "key": "mykey",
                        "action": "deleted"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "413": {
            "description": "Value 超过 5 MiB 限制",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": 0,
                  "error": "Value too large (max 5 MiB)"
                }
              }
            }
          }
        }
      }
    },
    "/{key}": {
      "post": {
        "tags": ["Write"],
        "summary": "直接写入（Body = 内容）",
        "description": "将请求 Body 作为内容直接写入指定 Key。适合写入二进制或非文本内容。密码通过 `X-Password` 请求头传递。",
        "parameters": [
          {
            "$ref": "#/components/parameters/KeyPath"
          },
          {
            "$ref": "#/components/parameters/XPassword"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "要写入的内容（文本或 JSON）",
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              },
              "example": "hello world"
            },
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "写入成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },
      "get": {
        "tags": ["Read"],
        "summary": "原始读取（text/plain）",
        "description": "以纯文本形式读取 Key 的内容。Key 不存在时返回空字符串（200）。读取不需要密码。",
        "parameters": [
          {
            "$ref": "#/components/parameters/KeyPath"
          }
        ],
        "responses": {
          "200": {
            "description": "原始内容",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "hello world"
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Write"],
        "summary": "删除 Key",
        "description": "删除指定 Key。已设置密码的 Key 需要通过 `X-Password` 请求头提供密码。",
        "parameters": [
          {
            "$ref": "#/components/parameters/KeyPath"
          },
          {
            "$ref": "#/components/parameters/XPassword"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResponse"
                },
                "example": {
                  "status": 1,
                  "data": {
                    "key": "mykey",
                    "action": "deleted"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/p/{key}": {
      "get": {
        "tags": ["Read"],
        "summary": "HTML 渲染",
        "description": "将 Key 内容作为 HTML 页面渲染返回。带 CSP 安全头（`script-src 'unsafe-inline'`、`connect-src 'none'`），适合托管静态 HTML 页面。",
        "parameters": [
          {
            "$ref": "#/components/parameters/KeyPath"
          }
        ],
        "responses": {
          "200": {
            "description": "渲染后的 HTML 页面",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Key 格式无效",
            "content": {
              "text/plain": {
                "example": "Invalid Key"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/file/{ext}/{key}": {
      "get": {
        "tags": ["Read"],
        "summary": "按扩展名读取文件",
        "description": "根据扩展名自动设置 `Content-Type`，以附件形式下载。`html` 和 `svg` 扩展名被拒绝（请使用 `/p/{key}` 渲染）。带 `X-Content-Type-Options: nosniff`。",
        "parameters": [
          {
            "$ref": "#/components/parameters/ExtPath"
          },
          {
            "$ref": "#/components/parameters/KeyPath"
          }
        ],
        "responses": {
          "200": {
            "description": "文件内容（附件下载）",
            "headers": {
              "Content-Type": {
                "description": "根据扩展名自动推断的 MIME 类型",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "description": "附件下载，文件名为 `{key}.{ext}`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Key 格式无效，或扩展名为 html/svg",
            "content": {
              "text/plain": {
                "examples": {
                  "invalidKey": {
                    "value": "Invalid Key"
                  },
                  "htmlRejected": {
                    "value": "Use /p/ for HTML/SVG rendering"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/md/{key}": {
      "get": {
        "tags": ["Read"],
        "summary": "Markdown 渲染",
        "description": "返回 SPA 页面，前端自动读取 Key 内容并渲染为 Markdown（支持 GFM、代码高亮、目录、数学公式、Mermaid 图表）。",
        "parameters": [
          {
            "$ref": "#/components/parameters/KeyPath"
          }
        ],
        "responses": {
          "200": {
            "description": "SPA 页面（前端渲染 Markdown）",
            "content": {
              "text/html": {}
            }
          },
          "400": {
            "description": "Key 格式无效",
            "content": {
              "text/plain": {
                "example": "Invalid Key"
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": ["Stats"],
        "summary": "统计信息",
        "description": "返回全局统计：总 Key 数、总存储量、今日写入次数。Key 数最多扫描 5000 个（超出时 `scannedAll=false`）。",
        "responses": {
          "200": {
            "description": "统计数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                },
                "example": {
                  "status": 1,
                  "data": {
                    "totalKeys": 128,
                    "totalSize": 524288,
                    "writesToday": 42,
                    "scannedAll": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
